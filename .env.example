# Copy this file to .env and fill in your own key locally.
# .env is ignored by Git. The application does not load it automatically.
# In bash/zsh, load it before starting the app:
#   set -a
#   source .env
#   set +a
GEMINI_API_KEY=

# Optional: uncomment and set this if Stockfish is not on PATH.
# STOCKFISH_PATH=/absolute/path/to/stockfish

# Local web server settings
CHESS_WEB_HOST=127.0.0.1
CHESS_WEB_PORT=8000
